<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14.0</LangVersion>
        <SignAssembly Condition="'$(SignAssembly)' == ''">false</SignAssembly>
        <AssemblyOriginatorKeyFile Condition="'$(EsoxSigningKeyFile)' != ''">$(EsoxSigningKeyFile)</AssemblyOriginatorKeyFile>
        <RepositoryUrl>https://github.com/snoekiede/Esox.SharpAndRusty</RepositoryUrl>
        <Company>Esox Solutions</Company>
        <Authors>Iede Snoek</Authors>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <Version>1.6.7.0</Version>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <AssemblyVersion>1.6.7.0</AssemblyVersion>
    </PropertyGroup>
    <PropertyGroup>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>
    <PropertyGroup>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>
    <PropertyGroup>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PackageProjectUrl>https://github.com/snoekiede/Esox.SharpAndRusty</PackageProjectUrl>
        <Copyright>(c) 2026 Esox Solutions</Copyright>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.103" PrivateAssets="All"/>
        <PackageReference Include="Microsoft.Build.Tasks.Git" Version="10.0.111" PrivateAssets="All"/>
    </ItemGroup>

    <Target Name="ValidateAssemblySigning" BeforeTargets="CoreCompile" Condition="'$(SignAssembly)' == 'true' and !Exists('$(AssemblyOriginatorKeyFile)')">
        <Error Text="Assembly signing is enabled, but the signing key was not found. Set EsoxSigningKeyFile to the secure .snk path." />
    </Target>


    <ItemGroup>
        <None Include="..\LICENSE.txt">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

</Project>
